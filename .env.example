# Mẫu file môi trường. File này ĐƯỢC commit, nên không chứa mật khẩu.
# Cách dùng: chép thành .env.dev (hoặc .env.staging, .env.prod) rồi điền giá trị thật.

# Tên hiển thị của môi trường, in ra đầu mỗi lần chạy
ENV_NAME=Dev

# Địa chỉ gốc của hai hệ thống, không có dấu / ở cuối
CRM_URL=https://crm.anhtester.com
BOOK_URL=https://book.anhtester.com

# Số worker chạy song song. Để trống: Playwright tự chọn một nửa số nhân CPU.
# CRM demo dùng chung một server: đo trên máy 32 nhân, 8 worker chạy nhanh nhất
WORKERS=

# Tài khoản CRM theo vai trò. Để trống ở file mẫu
CRM_ADMIN_EMAIL=
CRM_ADMIN_PASSWORD=
CRM_PM_EMAIL=
CRM_PM_PASSWORD=
CRM_CUSTOMER_EMAIL=
CRM_CUSTOMER_PASSWORD=

# Tài khoản Book cho các API cần đăng nhập (POST, PUT, PATCH, DELETE). Để trống ở file mẫu.
# Mật khẩu có dấu # hoặc dấu cách thì đặt trong ngoặc kép: BOOK_PASSWORD="abc#123" (không có ngoặc, dotenv cắt mất phần sau #)
BOOK_EMAIL=
BOOK_PASSWORD=
